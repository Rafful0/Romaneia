# Copie para .env e TROQUE os valores. Os padrões abaixo são só para desenvolvimento local.
POSTGRES_USER=romaneia
POSTGRES_PASSWORD=romaneia_dev
APP_DB_PASSWORD=app_dev
JWT_SECRET=dev-only-troque-este-segredo-em-qualquer-ambiente-real
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false
# Endereço em que o navegador abre o app (usado no retorno do login com Google)
APP_URL=http://localhost:8080
# dev = código de verificação do cadastro não é enviado: aparece na tela e no log do backend (protótipo)
VERIFICACAO_MODO=dev
# Login com Google: crie um OAuth Client ID (tipo "Aplicativo da Web") no Google Cloud Console com o
# redirecionamento autorizado http://localhost:8080/api/auth/google/retorno. Vazio = botão do Google oculto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# WhatsApp Cloud API (envio automático do pedido ao fornecedor). Vazio = só o link manual (wa.me).
# Passo a passo no README, seção "Envio automático pelo WhatsApp".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Modelos aprovados na Meta (opcional). Sem modelo, envia texto livre: só funciona se o fornecedor escreveu nas últimas 24 h.
WHATSAPP_MODELO=
WHATSAPP_MODELO_CANCELAMENTO=
WHATSAPP_MODELO_IDIOMA=pt_BR
# Webhook de status (entregue/lido). Precisa de URL pública HTTPS (ex.: túnel); opcional para a demonstração.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
